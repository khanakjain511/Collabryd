{
  "name": "@repo/api",
  "version": "1.0.0",
  "description": "Collabryd REST API backend",
  "main": "dist/server.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @collabryd/database build && tsx watch src/server.ts",
    "build": "pnpm --filter @collabryd/database build && tsc",
    "start": "node dist/server.js",
    "check-types": "tsc --noEmit",
    "test": "pnpm --filter @collabryd/database build && vitest run",
    "test:watch": "pnpm --filter @collabryd/database build && vitest"
  },
  "dependencies": {
    "@collabryd/database": "workspace:*",
    "argon2": "^0.43.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.6.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.9",
    "socket.io-client": "^4.8.4"
  }
}
