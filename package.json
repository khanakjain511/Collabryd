{
  "name": "collabryd",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "api:dev": "pnpm --filter @repo/api dev",
    "backend:dev": "pnpm --filter @repo/api dev",
    "backend:build": "pnpm --filter @repo/api build",
    "backend:test": "pnpm --filter @repo/api test",
    "db:migrate": "pnpm --filter @collabryd/database db:migrate",
    "db:seed": "pnpm --filter @collabryd/database db:seed"
  },
  "devDependencies": {
    "dotenv": "^18.0.9",
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
