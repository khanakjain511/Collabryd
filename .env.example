# Server Configuration
NODE_ENV=development
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL Configuration
POSTGRES_USER=collabryd
POSTGRES_PASSWORD=teammate_password
POSTGRES_DB=collabryd
DATABASE_HOST=localhost
DATABASE_PORT=5434
# Optional full connection string (overrides individual POSTGRES_* variables if set)
# DATABASE_URL=postgresql://collabryd:teammate_password@localhost:5434/collabryd

# Redis Configuration (optional; falls back to in-memory rate limiting if unavailable)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Configuration (change in production! min 32 chars)
JWT_ACCESS_SECRET=dev_collabryd_access_secret_change_me_in_production_32chars
JWT_REFRESH_SECRET=dev_collabryd_refresh_secret_change_me_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: Single-campus email domain restriction (comma-separated, empty = allow any email)
# ALLOWED_EMAIL_DOMAINS=university.edu,iitd.ac.in
ALLOWED_EMAIL_DOMAINS=

# Development defaults to local token responses. Production requires Resend.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=verify@example.org
# RESEND_API_KEY=
# VERIFICATION_PAGE_URL=https://app.example.org/verify-email
